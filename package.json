{
  "name": "radix-matix",
  "displayName": "Radix Matix",
  "description": "Soporte de sintaxis oficial para el lenguaje Radix Matix (.rm)",
  "version": "1.0.0",
  "publisher": "VoxMatrixStudios",
  "icon": "icons/logo-presentacion.png",
  "engines": {
    "vscode": "^1.74.0"
  },

  "main": "./extension.js",
  "activationEvents": ["onLanguage:radixmatix"],

  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "radixmatix",
        "aliases": ["Radix Matix", "radixmatix", "rm"],
        "extensions": [".rm"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/rm-icon.svg",
          "dark": "./icons/rm-icon.svg"
        }
      }
      
    ],
    "grammars": [
      {
        "language": "radixmatix",
        "scopeName": "source.rm",
        "path": "./syntaxes/radixmatix.tmLanguage.json"
      }
      
    ],
    "snippets": [
      {
        "language": "radixmatix",
        "path": "./snippets/radixmatix.json"
      }
    ]

  },

  "dependencies": {
    "@types/vscode": "1.74.0"
  }
  
}