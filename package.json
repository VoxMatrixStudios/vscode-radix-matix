{
  "name": "radix-matix",
  "displayName": "Radix Matix",
  "description": "Soporte de sintaxis oficial para el lenguaje Radix Matix (.rm)",
  "version": "2.2.3",
  "publisher": "VoxMatrixStudios",
  "license": "MIT",
  "homepage": "https://github.com/VoxMatrixStudios/vscode-radix-matix",
  "repository": {
    "type": "git",
    "url": "https://github.com/VoxMatrixStudios/vscode-radix-matix.git"
  },
  "bugs": {
    "url": "https://github.com/VoxMatrixStudios/vscode-radix-matix/issues"
  },
  "keywords": [
    "radixmatix",
    "radix",
    "rm",
    "education",
    "spanish",
    "bilingual",
    "compiler"
  ],
  "icon": "icons/logo-presentacion.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:radixmatix"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "El análisis sintáctico en tiempo real se desactiva en espacios de trabajo no confiables."
    }
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "radixmatix",
        "aliases": [
          "Radix Matix",
          "radixmatix",
          "rm"
        ],
        "extensions": [
          ".rm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/rm-icon.svg",
          "dark": "./icons/rm-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "radixmatix",
        "scopeName": "source.rm",
        "path": "./syntaxes/radixmatix.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "radixmatix",
        "path": "./snippets/radixmatix.json"
      }
    ],
    "configuration": {
      "title": "Radix Matix",
      "properties": {
        "radixmatix.corePath": {
          "type": "string",
          "default": "",
          "description": "Carpeta src del lenguaje Radix Matix (donde está lexer.py). Vacío = buscar una carpeta hermana.",
          "scope": "machine"
        },
        "radixmatix.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Ejecutable de Python 3.11 o superior (python, python3, py). Vacío = automático.",
          "scope": "machine"
        },
        "radixmatix.diagnosticos": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar errores mientras escribes."
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "1.74.0"
  }
}