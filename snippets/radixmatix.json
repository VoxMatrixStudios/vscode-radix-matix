{
  "Cabecera Español": {
    "prefix": "es",
    "body": [
      "#! es",
      "$0"
    ],
    "description": "Establece el idioma a español"
  },
  "Cabecera Inglés": {
    "prefix": "en",
    "body": [
      "#! en",
      "$0"
    ],
    "description": "Set language to English"
  },
  "Imprimir": {
    "prefix": "imp",
    "body": [
      "imprimir(${1:mensaje})"
    ],
    "description": "Imprime un valor o texto en pantalla"
  },
  "Print": {
    "prefix": "pr",
    "body": [
      "print(${1:message})"
    ],
    "description": "Print a value or message to the screen"
  },
  "Condicional Si": {
    "prefix": "si",
    "body": [
      "si ${1:condicion}:",
      "    ${0:hacer_algo}"
    ],
    "description": "Estructura condicional si"
  },
  "Condicional If": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "    ${0:do_something}"
    ],
    "description": "If conditional statement"
  },
  "Si-Sino": {
    "prefix": "sisi",
    "body": [
      "si ${1:condicion}:",
      "    ${2:hacer_algo}",
      "sino:",
      "    ${0:otro_caso}"
    ],
    "description": "Condicional si - sino"
  },
  "If-Else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition}:",
      "    ${2:do_something}",
      "else:",
      "    ${0:otherwise}"
    ],
    "description": "If - else conditional statement"
  },
  "Bucle Mientras": {
    "prefix": "mientras",
    "body": [
      "mientras ${1:condicion}:",
      "    ${0:hacer_algo}"
    ],
    "description": "Bucle mientras la condición sea verdadera"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition}:",
      "    ${0:do_something}"
    ],
    "description": "While loop"
  },
  "Función": {
    "prefix": "fun",
    "body": [
      "funcion ${1:nombre}(${2:argumentos}):",
      "    ${0:hacer_algo}"
    ],
    "description": "Declarar una función en español"
  },
  "Function": {
    "prefix": "def",
    "body": [
      "function ${1:name}(${2:arguments}):",
      "    ${0:do_something}"
    ],
    "description": "Define a function in English"
  },
  "Despejar Ecuación": {
    "prefix": "despejar",
    "body": [
      "despejar(\"${1:ecuacion}\", \"${2:variable}\")"
    ],
    "description": "Despeja analíticamente una variable en una ecuación lineal"
  },
  "Solve Equation": {
    "prefix": "solve",
    "body": [
      "solve(\"${1:equation}\", \"${2:variable}\")"
    ],
    "description": "Analytically solve for a variable in a linear equation"
  },
  "Bucle Para": {
    "prefix": "para",
    "body": [
      "para  en :",
      "    "
    ],
    "description": "Bucle para recorrer una lista o rango"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for  in :",
      "    "
    ],
    "description": "For loop over a list or range"
  },
  "Temporizador Cada": {
    "prefix": "cada",
    "body": [
      "cada :",
      "    "
    ],
    "description": "Temporizador repetitivo nativo"
  },
  "Timer Every": {
    "prefix": "every",
    "body": [
      "every :",
      "    "
    ],
    "description": "Native repetitive timer"
  },
  "Temporizador Después": {
    "prefix": "despues",
    "body": [
      "despues de :",
      "    "
    ],
    "description": "Temporizador de ejecución postergada"
  },
  "Timer After": {
    "prefix": "after",
    "body": [
      "after ${1:time}:",
      "    ${0:do_something}"
    ],
    "description": "Delayed single-shot timer"
  },
  "Cabecera Módulo Medio": {
    "prefix": "modmedio",
    "body": [
      "#! modulo medio",
      "$0"
    ],
    "description": "Establece el nivel al Módulo Medio (tipos, bits, estructuras)"
  },
  "Module Medium Header": {
    "prefix": "modmedium",
    "body": [
      "#! module medium",
      "$0"
    ],
    "description": "Sets the level to Medium Module (types, bits, structs)"
  },
  "Cabecera Módulo Bajo": {
    "prefix": "modbajo",
    "body": [
      "#! modulo bajo",
      "$0"
    ],
    "description": "Establece el nivel al Módulo Bajo (memoria simulada, punteros, pila)"
  },
  "Module Low Header": {
    "prefix": "modlow",
    "body": [
      "#! module low",
      "$0"
    ],
    "description": "Sets the level to Low Module (simulated memory, heap, stack)"
  },
  "Constante": {
    "prefix": "constante",
    "body": [
      "constante ${1:NOMBRE} = ${2:valor}"
    ],
    "description": "Declarar una constante inmutable"
  },
  "Const": {
    "prefix": "const",
    "body": [
      "const ${1:NAME} = ${2:value}"
    ],
    "description": "Declare an immutable constant"
  },
  "Estructura": {
    "prefix": "estructura",
    "body": [
      "estructura ${1:Nombre}:",
      "    ${2:campo}: ${3:tipo}"
    ],
    "description": "Definir una estructura de datos tipada"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}:",
      "    ${2:field}: ${3:type}"
    ],
    "description": "Define a typed data structure"
  },
  "Reservar Memoria": {
    "prefix": "reservar",
    "body": [
      "${1:ptr} = reservar(${2:cantidad_bytes})",
      "${0}",
      "liberar(${1:ptr})"
    ],
    "description": "Reservar y liberar memoria simulada en el montón"
  },
  "Allocate Memory": {
    "prefix": "allocate",
    "body": [
      "${1:ptr} = allocate(${2:bytes_count})",
      "${0}",
      "free(${1:ptr})"
    ],
    "description": "Allocate and free simulated heap memory"
  },
  "Guardar Entero": {
    "prefix": "guardar_entero",
    "body": [
      "guardar_entero(${1:direccion}, ${2:valor}, ${3:bytes_1_2_4_8})"
    ],
    "description": "Guarda un entero en little-endian en la memoria"
  },
  "Cargar Entero": {
    "prefix": "cargar_entero",
    "body": [
      "cargar_entero(${1:direccion}, ${2:bytes_1_2_4_8})"
    ],
    "description": "Carga un entero desde la memoria en little-endian"
  },
  "Volcar Memoria": {
    "prefix": "volcar",
    "body": [
      "volcar(${1:direccion}, ${2:cantidad})"
    ],
    "description": "Imprime un volcado hexadecimal de la memoria"
  },
  "Pila Empujar y Sacar": {
    "prefix": "pila",
    "body": [
      "empujar(${1:byte})",
      "${2:valor} = sacar()"
    ],
    "description": "Operaciones LIFO en la pila simulada"
  }
}
