{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Radix Matix",
  "scopeName": "source.rm",
  "patterns": [
    {
      "name": "comment.line.shebang.rm",
      "match": "^#!\\s*(es|en)\\b.*$"
    },
    {
      "name": "comment.line.double-slash.rm",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.rm",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.rm",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.rm",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    {
      "name": "constant.language.boolean.rm",
      "match": "\\b(verdad|falso|true|false)\\b"
    },
    {
      "name": "constant.language.null.rm",
      "match": "\\b(nada|null)\\b"
    },
    {
      "name": "constant.language.math.rm",
      "match": "\\b(pi|e)\\b"
    },
    {
      "name": "keyword.control.rm",
      "match": "\\b(si|sino\\s+si|sino|mientras|funcion|devolver|if|else\\s+if|else|while|func|return)\\b"
    },
    {
      "name": "keyword.operator.logical.rm",
      "match": "\\b(y|o|no|and|or|not)\\b"
    },
    {
      "name": "support.function.builtin.rm",
      "match": "\\b(imprimir|print|leer|input|entero|int|decimal|float|texto|str|aleatorio|random|raiz|root|potencia|power|factorial|log|ln|absoluto|abs|seno|sin|coseno|cos|tangente|tan|fraccion|fraction|despejar|solve)\\b"
    },
    {
      "name": "keyword.operator.arithmetic.rm",
      "match": "(\\+|-|\\*|/|%|\\^|==|!=|<=|>=|<|>|=)"
    }
  ]
}
